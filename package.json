{
  "name": "mensagens",
  "private": true,
  "version": "0.1.0",
  "description": "Aplicacao de mensagens para estudo de frontend, backend, banco de dados, autenticacao e tempo real.",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "pnpm --filter @mensagens/frontend run build",
    "dev:frontend": "pnpm --filter @mensagens/frontend run dev",
    "dev:backend": "pnpm --filter @mensagens/backend run dev",
    "build:frontend": "pnpm --filter @mensagens/frontend run build",
    "build:backend": "pnpm --filter @mensagens/backend run build"
  }
}
